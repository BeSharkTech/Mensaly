{
  "name": "mensaly",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter @mensaly/database generate",
    "db:migrate:deploy": "pnpm --filter @mensaly/database migrate:deploy",
    "db:seed": "pnpm --filter @mensaly/database seed",
    "db:seed:demo": "pnpm --filter @mensaly/api seed:demo",
    "dev": "turbo run dev",
    "env:test:validate": "docker compose -f infra/docker/compose.test.yaml config --quiet",
    "env:test:up": "docker compose -f infra/docker/compose.test.yaml up -d --wait",
    "env:test:status": "docker compose -f infra/docker/compose.test.yaml ps",
    "env:test:down": "docker compose -f infra/docker/compose.test.yaml down --volumes",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "api:openapi": "pnpm --filter @mensaly/api openapi:export",
    "postinstall": "pnpm db:generate",
    "production:check:staging": "tsx --env-file-if-exists=.env scripts/production-preflight.ts --target=staging",
    "production:check:live": "tsx --env-file-if-exists=.env scripts/production-preflight.ts --target=production",
    "production:check:single-vps": "tsx --env-file-if-exists=.env scripts/production-preflight.ts --target=single-vps",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:runtime": "pnpm --filter @mensaly/api test:runtime && pnpm --filter @mensaly/worker test:runtime"
  },
  "devDependencies": {
    "@mensaly/eslint-config": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "10.8.0",
    "turbo": "^2.10.8",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}

{
  "name": "mensaly",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter @mensaly/database generate",
    "dev": "turbo run dev",
    "env:test:validate": "docker compose -f infra/docker/compose.test.yaml config --quiet",
    "env:test:up": "docker compose -f infra/docker/compose.test.yaml up -d --wait",
    "env:test:status": "docker compose -f infra/docker/compose.test.yaml ps",
    "env:test:down": "docker compose -f infra/docker/compose.test.yaml down --volumes",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "postinstall": "pnpm db:generate",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@mensaly/eslint-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "10.8.0",
    "turbo": "^2.5.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}

{
  "name": "mensaly",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "env:test:validate": "docker compose -f infra/docker/compose.test.yaml config --quiet",
    "env:test:up": "docker compose -f infra/docker/compose.test.yaml up -d --wait",
    "env:test:status": "docker compose -f infra/docker/compose.test.yaml ps",
    "env:test:down": "docker compose -f infra/docker/compose.test.yaml down --volumes",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}

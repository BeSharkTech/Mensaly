generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  COMPANY_ACCOUNT
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PlanFrequency {
  MONTHLY
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum ChargeStatus {
  PENDING
  PAID
  CANCELLED
  WAIVED
}

enum PaymentStatus {
  PENDING_RECONCILIATION
  CONFIRMED
  REVERSED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  BANK_TRANSFER
  CARD
  OTHER
}

enum ReminderTiming {
  BEFORE_DUE
  ON_DUE
  AFTER_DUE
}

enum MessageScheduleStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED_RETRYABLE
  FAILED_PERMANENT
  CANCELLED
}

enum MessageDeliveryAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

enum WebhookAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String     @db.VarChar(120)
  email         String     @unique @db.Citext
  emailVerified Boolean    @default(false)
  image         String?    @db.VarChar(2048)
  role          UserRole   @default(COMPANY_ACCOUNT)
  status        UserStatus @default(PENDING_VERIFICATION)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  sessions     Session[]
  accounts     Account[]
  organization Organization?
  auditLogs    AuditLog[]    @relation("AuditActor")

  @@index([role, status])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(1024)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(100)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?   @db.Text
  idToken               String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id        String           @id @default(uuid()) @db.Uuid
  identifier String          @db.VarChar(255)
  tokenHash String           @unique @db.VarChar(64)
  type      VerificationType
  expiresAt DateTime         @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  @@index([identifier, type, createdAt])
  @@index([expiresAt])
  @@map("verification")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  ownerUserId String             @unique @db.Uuid
  name        String             @db.VarChar(120)
  legalName   String?            @db.VarChar(160)
  taxId       String?            @unique @db.VarChar(14)
  phone       String?            @db.VarChar(20)
  address     Json?
  timezone    String             @default("America/Sao_Paulo") @db.VarChar(64)
  status      OrganizationStatus @default(ACTIVE)
  brand       Json?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  owner     User       @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]
  plans Plan[]
  students Student[]
  guardians Guardian[]
  enrollments Enrollment[]
  charges Charge[]
  payments Payment[]
  reminderConfiguration ReminderConfiguration?
  messageTemplates MessageTemplate[]
  messageSchedules MessageSchedule[]
  messageRecipientBlocks MessageRecipientBlock[]
  webhookEvents WebhookEvent[]

  @@index([status])
  @@map("organization")
}

model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  provider String @db.VarChar(80)
  externalEventId String @db.VarChar(255)
  eventType String @db.VarChar(160)
  payload Json
  status WebhookEventStatus @default(PENDING)
  attemptCount Int @default(0)
  lastErrorCode String? @db.VarChar(120)
  lastErrorMessage String? @db.VarChar(1000)
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  processingStartedAt DateTime? @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  failedAt DateTime? @db.Timestamptz(3)
  nextAttemptAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization? @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  attempts WebhookEventAttempt[]
  @@unique([provider,externalEventId])
  @@index([status,nextAttemptAt,receivedAt])
  @@index([organizationId,status,receivedAt])
  @@map("webhook_event")
}

model WebhookEventAttempt {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  attemptNumber Int
  status WebhookAttemptStatus @default(STARTED)
  errorCode String? @db.VarChar(120)
  errorMessage String? @db.VarChar(1000)
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  event WebhookEvent @relation(fields:[eventId],references:[id],onDelete:Restrict)
  @@unique([eventId,attemptNumber])
  @@index([eventId,startedAt])
  @@map("webhook_event_attempt")
}

model Plan {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name String @db.VarChar(120)
  description String? @db.VarChar(1000)
  amountCents Int
  dueDay Int
  frequency PlanFrequency @default(MONTHLY)
  status PlanStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict)
  enrollments Enrollment[]
  @@index([organizationId, status])
  @@map("plan")
}

model Charge {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  enrollmentId String @db.Uuid
  referenceMonth DateTime @db.Date
  dueDate DateTime @db.Date
  amountCents Int
  discountCents Int @default(0)
  finalAmountCents Int
  status ChargeStatus @default(PENDING)
  cancelledAt DateTime? @db.Timestamptz(3)
  waivedAt DateTime? @db.Timestamptz(3)
  paidAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  enrollment Enrollment @relation(fields:[organizationId,enrollmentId],references:[organizationId,id],onDelete:Restrict)
  payments Payment[]
  messageSchedules MessageSchedule[]
  @@unique([organizationId,enrollmentId,referenceMonth])
  @@unique([organizationId,id])
  @@index([organizationId,status,dueDate])
  @@map("charge")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  chargeId String @db.Uuid
  idempotencyKey String @db.VarChar(128)
  amountCents Int
  method PaymentMethod
  status PaymentStatus @default(PENDING_RECONCILIATION)
  paidAt DateTime @db.Timestamptz(3)
  externalReference String? @db.VarChar(255)
  notes String? @db.VarChar(1000)
  reversedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  charge Charge @relation(fields:[organizationId,chargeId],references:[organizationId,id],onDelete:Restrict)
  @@unique([organizationId,idempotencyKey])
  @@index([organizationId,status,paidAt])
  @@index([chargeId])
  @@map("payment")
}

model ReminderConfiguration {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid
  enabled Boolean @default(false)
  sendWindowStartMinute Int @default(480)
  sendWindowEndMinute Int @default(1080)
  dailyLimit Int @default(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  rules ReminderRule[]
  @@unique([organizationId,id])
  @@map("reminder_configuration")
}

model ReminderRule {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  configurationId String @db.Uuid
  timing ReminderTiming
  dayOffset Int
  templateId String? @db.Uuid
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  configuration ReminderConfiguration @relation(fields:[organizationId,configurationId],references:[organizationId,id],onDelete:Restrict)
  template MessageTemplate? @relation(fields:[organizationId,templateId],references:[organizationId,id],onDelete:Restrict)
  @@unique([organizationId,timing,dayOffset])
  @@index([configurationId,enabled])
  @@index([organizationId,templateId])
  @@map("reminder_rule")
}

model MessageTemplate {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name String @db.Citext
  body String @db.VarChar(4000)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  schedules MessageSchedule[]
  reminderRules ReminderRule[]
  @@unique([organizationId,name])
  @@unique([organizationId,id])
  @@index([organizationId,active,name])
  @@map("message_template")
}

model MessageSchedule {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  chargeId String @db.Uuid
  templateId String @db.Uuid
  status MessageScheduleStatus @default(SCHEDULED)
  scheduledFor DateTime @db.Timestamptz(3)
  deduplicationKey String @db.VarChar(64)
  automationKey String? @db.VarChar(80)
  templateBodySnapshot String @db.VarChar(4000)
  recipientNameSnapshot String @db.VarChar(120)
  recipientPhoneSnapshot String @db.VarChar(20)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancellationReason String? @db.VarChar(120)
  attemptCount Int @default(0)
  lastAttemptAt DateTime? @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  sentLocalDate DateTime? @db.Date
  deliveredAt DateTime? @db.Timestamptz(3)
  readAt DateTime? @db.Timestamptz(3)
  providerMessageId String? @db.VarChar(255)
  lastErrorCode String? @db.VarChar(120)
  lastErrorMessage String? @db.VarChar(1000)
  queuedAt DateTime? @db.Timestamptz(3)
  enqueuedFor DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  charge Charge @relation(fields:[organizationId,chargeId],references:[organizationId,id],onDelete:Restrict)
  template MessageTemplate @relation(fields:[organizationId,templateId],references:[organizationId,id],onDelete:Restrict)
  history MessageScheduleHistory[]
  deliveryAttempts MessageDeliveryAttempt[]
  @@unique([organizationId,deduplicationKey])
  @@unique([organizationId,chargeId,automationKey])
  @@unique([organizationId,id])
  @@index([organizationId,status,scheduledFor])
  @@index([chargeId,status])
  @@index([organizationId,sentLocalDate])
  @@map("message_schedule")
}

model MessageScheduleHistory {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  scheduleId String @db.Uuid
  fromStatus MessageScheduleStatus?
  toStatus MessageScheduleStatus
  reason String @db.VarChar(120)
  metadata Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  schedule MessageSchedule @relation(fields:[organizationId,scheduleId],references:[organizationId,id],onDelete:Restrict)
  @@index([scheduleId,createdAt])
  @@index([organizationId,createdAt])
  @@map("message_schedule_history")
}

model MessageDeliveryAttempt {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  scheduleId String @db.Uuid
  attemptNumber Int
  status MessageDeliveryAttemptStatus @default(STARTED)
  idempotencyKey String @db.VarChar(128)
  providerMessageId String? @db.VarChar(255)
  errorCode String? @db.VarChar(120)
  errorMessage String? @db.VarChar(1000)
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  schedule MessageSchedule @relation(fields:[organizationId,scheduleId],references:[organizationId,id],onDelete:Restrict)
  @@unique([organizationId,scheduleId,attemptNumber])
  @@index([scheduleId,startedAt])
  @@index([organizationId,status,startedAt])
  @@map("message_delivery_attempt")
}

model MessageRecipientBlock {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  phone String @db.VarChar(20)
  reason String @db.VarChar(120)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  @@unique([organizationId,phone])
  @@index([organizationId,active])
  @@map("message_recipient_block")
}

model Student {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name String @db.VarChar(120)
  email String? @db.Citext
  phone String? @db.VarChar(20)
  notes String? @db.VarChar(2000)
  status StudentStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict)
  guardianLinks StudentGuardian[]
  enrollments Enrollment[]
  @@index([organizationId, status, name])
  @@map("student")
}

model Guardian {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name String @db.VarChar(120)
  taxId String? @db.VarChar(14)
  phone String @db.VarChar(20)
  email String? @db.Citext
  status GuardianStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict)
  studentLinks StudentGuardian[]
  enrollments Enrollment[]
  @@index([organizationId, status, name])
  @@unique([organizationId, taxId])
  @@map("guardian")
}

model StudentGuardian {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  studentId String @db.Uuid
  guardianId String @db.Uuid
  relationship String? @db.VarChar(80)
  active Boolean @default(true)
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  student Student @relation(fields:[studentId], references:[id], onDelete: Restrict)
  guardian Guardian @relation(fields:[guardianId], references:[id], onDelete: Restrict)
  @@index([organizationId, studentId, active])
  @@index([organizationId, guardianId, active])
  @@map("student_guardian")
}

model Enrollment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  studentId String @db.Uuid
  guardianId String @db.Uuid
  planId String @db.Uuid
  amountCents Int
  dueDay Int
  discountCents Int @default(0)
  startDate DateTime @db.Date
  endDate DateTime? @db.Date
  status EnrollmentStatus @default(ACTIVE)
  planNameSnapshot String @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete: Restrict)
  student Student @relation(fields:[studentId], references:[id], onDelete: Restrict)
  guardian Guardian @relation(fields:[guardianId], references:[id], onDelete: Restrict)
  plan Plan @relation(fields:[planId], references:[id], onDelete: Restrict)
  charges Charge[]
  @@unique([organizationId,id])
  @@index([organizationId, status])
  @@index([organizationId, studentId])
  @@map("enrollment")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @db.Uuid
  actorUserId    String?        @db.Uuid
  actorType      AuditActorType
  action         String         @db.VarChar(120)
  entityType     String         @db.VarChar(120)
  entityId       String?        @db.VarChar(255)
  before         Json?
  after          Json?
  correlationId  String?        @db.Uuid
  ipAddress      String?        @db.VarChar(64)
  userAgent      String?        @db.VarChar(1024)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

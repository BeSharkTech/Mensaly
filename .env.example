# Aplicacoes
NODE_ENV=development
API_PORT=3001

# PostgreSQL local
POSTGRES_DB=mensaly
POSTGRES_USER=mensaly
POSTGRES_PASSWORD=mensaly_local
POSTGRES_PORT=5432

# Redis local
REDIS_PORT=6379

# Enderecos usados pela API, pelo Prisma e pelos workers
DATABASE_URL=postgresql://mensaly:mensaly_local@localhost:5432/mensaly?schema=public
REDIS_URL=redis://localhost:6379

# Servicos locais isolados para testes
TEST_POSTGRES_PORT=55432
TEST_REDIS_PORT=56379
TEST_DATABASE_URL=postgresql://mensaly_test:mensaly_test_local@localhost:55432/mensaly_test?schema=public
TEST_REDIS_URL=redis://localhost:56379

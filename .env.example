# Aplicacoes
NODE_ENV=development
API_PORT=3001
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:3000

# PostgreSQL local
POSTGRES_DB=mensaly
POSTGRES_USER=mensaly
POSTGRES_PASSWORD=mensaly_local
POSTGRES_PORT=5432

# Redis local
REDIS_PORT=6379

# Enderecos usados pela API, pelo Prisma e pelos workers
DATABASE_URL=postgresql://mensaly:mensaly_local@localhost:5432/mensaly?schema=public
REDIS_URL=redis://localhost:6379

# Filas e worker BullMQ
BULLMQ_PREFIX=mensaly
BULLMQ_WORKER_CONCURRENCY=5
BULLMQ_JOB_ATTEMPTS=4
BULLMQ_BACKOFF_MS=1000
BULLMQ_METRICS_INTERVAL_MS=30000
SCHEDULER_INTERVAL_MS=60000
SCHEDULER_LOOKAHEAD_MS=86400000
FAKE_MESSAGE_ADAPTER_OUTCOME=READ
MESSAGE_AUTOMATION_ENABLED=true

# Autenticação local (em horas; máximo de 30 dias)
AUTH_SESSION_TTL_HOURS=168
LOCAL_STORAGE_PATH=.local-storage
FILE_MAX_SIZE_BYTES=5242880

# Object storage (required in staging and production; use S3 or Cloudflare R2)
FILE_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Observability (optional locally; configure Sentry in staging/production)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# E-mail transacional. Use local para capturar mensagens em testes; producao exige Resend.
EMAIL_DELIVERY_MODE=local
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
WEB_APP_URL=http://localhost:5173
EMAIL_ENCRYPTION_KEY=

# Stripe permanece inativo. Cobranças dos alunos usam Mercado Pago.
STRIPE_CONNECT_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_MODE=disabled
MERCADOPAGO_CONNECTION_MODE=oauth
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_AUTH_BASE_URL=https://auth.mercadopago.com
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_OAUTH_REDIRECT_URI=
MERCADOPAGO_WEBHOOK_SECRET=
PAYMENT_PROVIDER_ENCRYPTION_KEY=
PAYMENT_LINK_SECRET=
PUBLIC_ENROLLMENT_LINK_SECRET=

# Public deployment addresses (required by infra/docker/compose.app.yaml)
PUBLIC_API_URL=https://api.example.com
PUBLIC_WEB_URL=https://app.example.com
WEB_PORT=5173
MENSALY_IMAGE=ghcr.io/besharktech/mensaly:sha-REPLACE_WITH_APPROVED_COMMIT

# Servicos locais isolados para testes
TEST_POSTGRES_PORT=55432
TEST_REDIS_PORT=56379
TEST_DATABASE_URL=postgresql://mensaly_test:mensaly_test_local@localhost:55432/mensaly_test?schema=public
TEST_REDIS_URL=redis://localhost:56379

# Seed local (nao cria senha; autenticacao sera implementada na Fase 2)
SEED_PLATFORM_ADMIN_EMAIL=admin@mensaly.local

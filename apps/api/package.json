{
  "name": "@mensaly/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test src/**/*.test.ts",
    "test:runtime": "node --test integration/runtime.test.cjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@mensaly/auth": "workspace:*",
    "@mensaly/config": "workspace:*",
    "@mensaly/contracts": "workspace:*",
    "@mensaly/database": "workspace:*",
    "@mensaly/logger": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.4.6",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}

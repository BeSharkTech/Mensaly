{
  "name": "@mensaly/worker",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 integration/**/*.test.ts",
    "test:runtime": "node --test integration/runtime.test.cjs"
  },
  "dependencies": {
    "@mensaly/auth": "workspace:*",
    "@mensaly/config": "workspace:*",
    "@mensaly/database": "workspace:*",
    "@mensaly/logger": "workspace:*",
    "@mensaly/queue": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}

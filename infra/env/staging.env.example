# Copy to a secret file outside the repository, replace every placeholder and run:
# pnpm production:check:staging
NODE_ENV=production
API_PORT=3001
TRUST_PROXY_HOPS=1
CORS_ORIGINS=https://app.staging.mensaly.online
AUTH_SESSION_TTL_HOURS=168

DATABASE_URL=postgresql://mensaly_app:REPLACE_WITH_RANDOM_PASSWORD@REPLACE_WITH_DATABASE_HOST:5432/mensaly?sslmode=require
REDIS_URL=rediss://default:REPLACE_WITH_RANDOM_PASSWORD@REPLACE_WITH_REDIS_HOST:6379

BULLMQ_PREFIX=mensaly-staging
BULLMQ_WORKER_CONCURRENCY=5
BULLMQ_JOB_ATTEMPTS=4
BULLMQ_BACKOFF_MS=1000
BULLMQ_METRICS_INTERVAL_MS=30000
SCHEDULER_INTERVAL_MS=60000
SCHEDULER_LOOKAHEAD_MS=86400000
FAKE_MESSAGE_ADAPTER_OUTCOME=PERMANENT_FAILURE
MESSAGE_AUTOMATION_ENABLED=false

FILE_STORAGE_DRIVER=s3
FILE_MAX_SIZE_BYTES=5242880
S3_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mensaly-staging-files
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
S3_FORCE_PATH_STYLE=false

SENTRY_DSN=https://REPLACE_WITH_SENTRY_DSN
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_API_BASE_URL=https://sentry.io/api/0
SENTRY_API_TOKEN=REPLACE_WITH_READ_ONLY_SENTRY_TOKEN
SENTRY_ORG_SLUG=REPLACE_WITH_SENTRY_ORGANIZATION
SENTRY_PROJECT_ID=REPLACE_WITH_NUMERIC_SENTRY_PROJECT_ID
ADMIN_MONTHLY_FIXED_COST_CENTS=0
ADMIN_EMAIL_COST_PER_THOUSAND_CENTS=0
ADMIN_STORAGE_COST_PER_GB_CENTS=0

EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM_EMAIL=contato@mensaly.online
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_WEBHOOK_SECRET
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

STRIPE_CONNECT_MODE=test
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_STRIPE_PUBLIC_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET
PAYMENT_LINK_SECRET=REPLACE_WITH_DIFFERENT_32_BYTE_BASE64_KEY

WEB_APP_URL=https://app.staging.mensaly.online
PUBLIC_WEB_URL=https://app.staging.mensaly.online
PUBLIC_API_URL=https://api.staging.mensaly.online
WEB_PORT=5173
MENSALY_IMAGE=ghcr.io/besharktech/mensaly:sha-replace-with-approved-40-character-commit

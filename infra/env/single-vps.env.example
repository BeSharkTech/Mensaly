# Copy outside the repository as /opt/mensaly/.env.production and replace every
# placeholder. This profile keeps PostgreSQL and Redis private to the VPS.
NODE_ENV=production
MENSALY_IMAGE=ghcr.io/besharktech/mensaly:sha-REPLACE_WITH_APPROVED_40_CHARACTER_COMMIT

PUBLIC_WEB_HOST=app.mensaly.online
PUBLIC_WEB_URL=https://app.mensaly.online
PUBLIC_API_HOST=api.mensaly.online
PUBLIC_API_URL=https://api.mensaly.online
CADDY_EMAIL=contato@mensaly.online

POSTGRES_DB=mensaly
POSTGRES_USER=mensaly_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_REDIS_PASSWORD

BULLMQ_PREFIX=mensaly-production
BULLMQ_WORKER_CONCURRENCY=3
BULLMQ_JOB_ATTEMPTS=4
BULLMQ_BACKOFF_MS=1000
BULLMQ_METRICS_INTERVAL_MS=30000
SCHEDULER_INTERVAL_MS=60000
SCHEDULER_LOOKAHEAD_MS=86400000
AUTH_SESSION_TTL_HOURS=168

# Cloudflare R2 is still required for uploaded files and off-VPS backups.
S3_ENDPOINT=https://REPLACE_WITH_R2_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mensaly-production-files
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
S3_FORCE_PATH_STYLE=false
BACKUP_PREFIX=backups/postgres
BACKUP_RETENTION_DAYS=30

SENTRY_DSN=https://REPLACE_WITH_SENTRY_DSN
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_API_BASE_URL=https://sentry.io/api/0
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_ID=

# Admin cost assumptions in BRL cents. These values are estimates, not invoices.
ADMIN_MONTHLY_FIXED_COST_CENTS=0
ADMIN_EMAIL_COST_PER_THOUSAND_CENTS=0
ADMIN_STORAGE_COST_PER_GB_CENTS=0

RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM_EMAIL=contato@mensaly.online
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_WEBHOOK_SECRET
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Student payments use Mercado Pago. Stripe remains disabled until the
# separate Mensaly SaaS subscription flow is explicitly activated.
STRIPE_CONNECT_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_MODE=live
MERCADOPAGO_CONNECTION_MODE=oauth
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_AUTH_BASE_URL=https://auth.mercadopago.com
MERCADOPAGO_CLIENT_ID=REPLACE_WITH_MERCADOPAGO_CLIENT_ID
MERCADOPAGO_CLIENT_SECRET=REPLACE_WITH_MERCADOPAGO_CLIENT_SECRET
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_OAUTH_REDIRECT_URI=https://app.mensaly.online/api/v1/payment-integrations/mercadopago/callback
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_WITH_MERCADOPAGO_WEBHOOK_SECRET
PAYMENT_PROVIDER_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_32_BYTE_BASE64_KEY
PAYMENT_LINK_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_BASE64_KEY
